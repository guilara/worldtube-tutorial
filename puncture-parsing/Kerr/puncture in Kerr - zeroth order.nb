Cell[CellGroupData[{

Cell["\[CurlyRho] definitions", "Subsubsection",
 CellChangeTimes->{{3.9690120245816784`*^9, 
  3.969012028246853*^9}},ExpressionUUID->"7841be5d-fc2e-114a-879e-\
4521076b077c"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"\[CurlyRho]", "[", 
    RowBox[{
    "\[CapitalDelta]x_", ",", "\[CapitalDelta]y_", ",", "\[CapitalDelta]z_", 
     ",", "t_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"\[CapitalDelta]x", "^", "2"}], "+", 
     RowBox[{"\[CapitalDelta]y", "^", "2"}], "+", 
     RowBox[{"\[CapitalDelta]z", "^", "2"}], "+", 
     RowBox[{
      RowBox[{"\[CapitalDelta]x", "^", "2"}], "*", 
      RowBox[{
       RowBox[{"kxp", "[", "t", "]"}], "^", "2"}], "*", 
      RowBox[{"Vp", "[", "t", "]"}]}], "+", 
     RowBox[{
      RowBox[{"\[CapitalDelta]y", "^", "2"}], "*", 
      RowBox[{
       RowBox[{"kyp", "[", "t", "]"}], "^", "2"}], "*", 
      RowBox[{"Vp", "[", "t", "]"}]}], "+", 
     RowBox[{"2", "*", "\[CapitalDelta]y", "*", "\[CapitalDelta]z", "*", 
      RowBox[{"kyp", "[", "t", "]"}], "*", 
      RowBox[{"kzp", "[", "t", "]"}], "*", 
      RowBox[{"Vp", "[", "t", "]"}]}], "+", 
     RowBox[{
      RowBox[{"\[CapitalDelta]z", "^", "2"}], "*", 
      RowBox[{
       RowBox[{"kzp", "[", "t", "]"}], "^", "2"}], "*", 
      RowBox[{"Vp", "[", "t", "]"}]}], "+", 
     RowBox[{"2", "*", "\[CapitalDelta]x", "*", 
      RowBox[{"kxp", "[", "t", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[CapitalDelta]y", "*", 
         RowBox[{"kyp", "[", "t", "]"}]}], "+", 
        RowBox[{"\[CapitalDelta]z", "*", 
         RowBox[{"kzp", "[", "t", "]"}]}]}], ")"}], "*", 
      RowBox[{"Vp", "[", "t", "]"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalDelta]z", "*", 
          RowBox[{"kzp", "[", "t", "]"}], "*", 
          RowBox[{"Vp", "[", "t", "]"}]}], "+", 
         RowBox[{"\[CapitalDelta]x", "*", 
          RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
         RowBox[{"\[CapitalDelta]x", "*", 
          RowBox[{
           RowBox[{"kxp", "[", "t", "]"}], "^", "2"}], "*", 
          RowBox[{"Vp", "[", "t", "]"}], "*", 
          RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
         RowBox[{"\[CapitalDelta]y", "*", 
          RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
         RowBox[{"\[CapitalDelta]y", "*", 
          RowBox[{
           RowBox[{"kyp", "[", "t", "]"}], "^", "2"}], "*", 
          RowBox[{"Vp", "[", "t", "]"}], "*", 
          RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
         RowBox[{"\[CapitalDelta]z", "*", 
          RowBox[{"zpdot", "[", "t", "]"}]}], "+", 
         RowBox[{"\[CapitalDelta]z", "*", 
          RowBox[{
           RowBox[{"kzp", "[", "t", "]"}], "^", "2"}], "*", 
          RowBox[{"Vp", "[", "t", "]"}], "*", 
          RowBox[{"zpdot", "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"kxp", "[", "t", "]"}], "*", 
          RowBox[{"Vp", "[", "t", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]x", "+", 
            RowBox[{"\[CapitalDelta]z", "*", 
             RowBox[{"kzp", "[", "t", "]"}], "*", 
             RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
            RowBox[{
             RowBox[{"kyp", "[", "t", "]"}], "*", 
             RowBox[{"(", 
