Cell[BoxData[
 RowBox[{
  RowBox[{"taudot", "[", "t_", "]"}], ":=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"xpdot", "[", "t", "]"}], "^", "2"}], "-", 
    RowBox[{
     RowBox[{"ypdot", "[", "t", "]"}], "^", "2"}], "-", 
    RowBox[{
     RowBox[{"zpdot", "[", "t", "]"}], "^", "2"}], "-", 
    RowBox[{
     RowBox[{"Vp", "[", "t", "]"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"kxp", "[", "t", "]"}], "*", 
         RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"kyp", "[", "t", "]"}], "*", 
         RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"kzp", "[", "t", "]"}], "*", 
         RowBox[{"zpdot", "[", "t", "]"}]}]}], ")"}], "^", "2"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.896802187605513*^9, 3.896802224661522*^9}, {
   3.8968126703942266`*^9, 3.896812684233827*^9}, 3.896812840406231*^9, 
   3.896813333361297*^9, 3.9480520658975844`*^9, {3.9480536031546564`*^9, 
   3.9480536530820637`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"9a875527-1a6f-4032-b67a-051b33141652"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tauddot", "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"xpddot", "[", "t", "]"}], "*", 
        RowBox[{"xpdot", "[", "t", "]"}]}], ")"}]}], "-", 
     RowBox[{
      RowBox[{"ypddot", "[", "t", "]"}], "*", 
      RowBox[{"ypdot", "[", "t", "]"}]}], "-", 
     RowBox[{
      RowBox[{"zpddot", "[", "t", "]"}], "*", 
      RowBox[{"zpdot", "[", "t", "]"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"dxVp", "[", "t", "]"}], "*", 
           RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"dyVp", "[", "t", "]"}], "*", 
           RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"dzVp", "[", "t", "]"}], "*", 
           RowBox[{"zpdot", "[", "t", "]"}]}]}], ")"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"kxp", "[", "t", "]"}], "*", 
            RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"kyp", "[", "t", "]"}], "*", 
            RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"kzp", "[", "t", "]"}], "*", 
            RowBox[{"zpdot", "[", "t", "]"}]}]}], ")"}], "^", "2"}]}], ")"}], 
      "/", "2"}], "-", 
     RowBox[{
      RowBox[{"Vp", "[", "t", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"kxp", "[", "t", "]"}], "*", 
         RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"kyp", "[", "t", "]"}], "*", 
         RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"kzp", "[", "t", "]"}], "*", 
         RowBox[{"zpdot", "[", "t", "]"}]}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"kxp", "[", "t", "]"}], "*", 
         RowBox[{"xpddot", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"kyp", "[", "t", "]"}], "*", 
         RowBox[{"ypddot", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"kzp", "[", "t", "]"}], "*", 
         RowBox[{"zpddot", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"xpdot", "[", "t", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"dxkxp", "[", "t", "]"}], "*", 
            RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"dykxp", "[", "t", "]"}], "*", 
            RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"dzkxp", "[", "t", "]"}], "*", 
            RowBox[{"zpdot", "[", "t", "]"}]}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"ypdot", "[", "t", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"dxkyp", "[", "t", "]"}], "*", 
            RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"dykyp", "[", "t", "]"}], "*", 
            RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"dzkyp", "[", "t", "]"}], "*", 
            RowBox[{"zpdot", "[", "t", "]"}]}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"zpdot", "[", "t", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"dxkzp", "[", "t", "]"}], "*", 
            RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"dykzp", "[", "t", "]"}], "*", 
            RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"dzkzp", "[", "t", "]"}], "*", 
            RowBox[{"zpdot", "[", "t", "]"}]}]}], ")"}]}]}], ")"}]}]}], ")"}],
    "/", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"xpdot", "[", "t", "]"}], "^", "2"}], "-", 
     RowBox[{
      RowBox[{"ypdot", "[", "t", "]"}], "^", "2"}], "-", 
     RowBox[{
      RowBox[{"zpdot", "[", "t", "]"}], "^", "2"}], "-", 
     RowBox[{
      RowBox[{"Vp", "[", "t", "]"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"kxp", "[", "t", "]"}], "*", 
          RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"kyp", "[", "t", "]"}], "*", 
          RowBox[{"ypdot", "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"kzp", "[", "t", "]"}], "*", 
          RowBox[{"zpdot", "[", "t", "]"}]}]}], ")"}], "^", "2"}]}]}], 
    "]"}]}]}]], "Input",
