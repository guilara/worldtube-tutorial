Notebook[{

Cell[CellGroupData[{
Cell["Puncture for generic orbits in Kerr", "Section",
 CellChangeTimes->{{3.8968005969861417`*^9, 3.896800601928781*^9}, {
  3.9494276326986437`*^9, 
  3.9494276343811865`*^9}},ExpressionUUID->"a27bfbd6-c819-40bc-b55f-\
c865df2422c8"],

Cell[TextData[{
 "ft = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", "t"], " ", "=", " ", 
    RowBox[{
     FractionBox["q", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["g", "t\[Alpha]"], "+", 
       RowBox[{
        SuperscriptBox["u", "t"], 
        SuperscriptBox["u", "\[Alpha]"]}]}], ")"}], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Alpha]"], 
      SuperscriptBox["\[CapitalPsi]", "R"]}]}]}], TraditionalForm]],
  ExpressionUUID->"79bef924-7871-4798-8adc-7d61ce5e825a"],
 " is the ",
 StyleBox["t",
  FontSlant->"Italic"],
 " component of the self-force per unit mass. All fields here are evaluated \
at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "i"], "=", 
    RowBox[{
     SubsuperscriptBox["x", "p", "i"], "(", "t", ")"}]}], TraditionalForm]],
  ExpressionUUID->"3436dff1-649a-4aba-80d1-a018c9e296a1"],
 "\nfx = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", "x"], " ", "=", " ", 
    RowBox[{
     FractionBox["q", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["g", "x\[Alpha]"], "+", 
       RowBox[{
        SuperscriptBox["u", "x"], 
        SuperscriptBox["u", "\[Alpha]"]}]}], ")"}], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Alpha]"], 
      SuperscriptBox["\[CapitalPsi]", "R"]}]}]}], TraditionalForm]],
  ExpressionUUID->"534c7abf-0fe7-4d1d-be1f-dbde239d66e5"],
 " is the x component\nfy = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", "y"], " ", "=", " ", 
    RowBox[{
     FractionBox["q", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["g", "y\[Alpha]"], "+", 
       RowBox[{
        SuperscriptBox["u", "y"], 
        SuperscriptBox["u", "\[Alpha]"]}]}], ")"}], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Alpha]"], 
      SuperscriptBox["\[CapitalPsi]", "R"]}]}]}], TraditionalForm]],
  ExpressionUUID->"2c2e527a-fadf-41ad-a458-d9defe407e72"],
 " is the y component\nfz = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", "z"], " ", "=", " ", 
    RowBox[{
     FractionBox["q", "\[Mu]"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["g", "z\[Alpha]"], "+", 
       RowBox[{
        SuperscriptBox["u", "z"], 
        SuperscriptBox["u", "\[Alpha]"]}]}], ")"}], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Alpha]"], 
      SuperscriptBox["\[CapitalPsi]", "R"]}]}]}], TraditionalForm]],
  ExpressionUUID->"248215b6-337c-486d-b04a-0504f09422c2"],
 " is the z component\nftdot = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["df", "t"], TraditionalForm]],ExpressionUUID->
  "885f1d1a-5586-4007-9cb0-7acb7fda114c"],
 "/dt\nfxdot = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["df", "x"], TraditionalForm]],ExpressionUUID->
  "0b194cc1-be24-4c63-91bc-cc813a85a2bd"],
 "/dt\nfydot = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["df", "y"], TraditionalForm]],ExpressionUUID->
  "418574c1-df4e-4646-b33d-d34be23fc417"],
 "/dt \nfzdot = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["df", "z"], TraditionalForm]],ExpressionUUID->
  "0fea25ca-6dfe-4fe9-8e78-e79044712a54"],
 "/dt \n\nDuft = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["u", "\[Beta]"], 
       RowBox[{
        SubscriptBox["\[Del]", "\[Beta]"], "f"}]}], ")"}], "t"], " ", "=", 
    RowBox[{
     FractionBox["ftdot", "taudot"], "+", 
     RowBox[{
      SubsuperscriptBox["\[CapitalGamma]", "\[Alpha]\[Beta]", "t"], 
      SuperscriptBox["u", "\[Alpha]"], 
      SuperscriptBox["f", "\[Beta]"], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"b9e40397-243c-4a74-ae26-ba6d10f3aa79"],
 "is the ",
 StyleBox["t",
  FontSlant->"Italic"],
 " component of the covariant derivative of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["f", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "1f77682b-c841-4b8c-879d-a3b5be90d3e3"],
 ". It should be written directly in terms of derivatives of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPsi]", "R"], TraditionalForm]],ExpressionUUID->
  "615aa7a3-9bc2-47ab-8592-1bc89609efed"],
 ". All fields here are evaluated at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "i"], "=", 
    RowBox[{
     SubsuperscriptBox["x", "p", "i"], "(", "t", ")"}]}], TraditionalForm]],
  ExpressionUUID->"25754920-99b5-41e0-a720-9831a82b644f"],
 "\nDufx = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["u", "\[Beta]"], 
       RowBox[{
        SubscriptBox["\[Del]", "\[Beta]"], "f"}]}], ")"}], "x"], " ", "=", 
    RowBox[{
     FractionBox["fxdot", "taudot"], "+", 
     RowBox[{
      SubsuperscriptBox["\[CapitalGamma]", "\[Alpha]\[Beta]", "x"], 
      SuperscriptBox["u", "\[Alpha]"], 
      SuperscriptBox["f", "\[Beta]"], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"ada9c425-0109-43ca-9109-592fd0b92119"],
 "is the ",
 StyleBox["x",
  FontSlant->"Italic"],
 " component\nDufy = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["u", "\[Beta]"], 
       RowBox[{
        SubscriptBox["\[Del]", "\[Beta]"], "f"}]}], ")"}], "y"], " ", "=", 
    RowBox[{
     FractionBox["fydot", "taudot"], "+", 
     RowBox[{
      SubsuperscriptBox["\[CapitalGamma]", "\[Alpha]\[Beta]", "y"], 
      SuperscriptBox["u", "\[Alpha]"], 
      SuperscriptBox["f", "\[Beta]"], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"c82414ee-9ad5-4d90-bae7-81e361b695eb"],
 "is the ",
 StyleBox["y",
  FontSlant->"Italic"],
 " component\nDufz = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["u", "\[Beta]"], 
       RowBox[{
        SubscriptBox["\[Del]", "\[Beta]"], "f"}]}], ")"}], "z"], " ", "=", 
    RowBox[{
     FractionBox["fzdot", "taudot"], "+", 
     RowBox[{
      SubsuperscriptBox["\[CapitalGamma]", "\[Alpha]\[Beta]", "z"], 
      SuperscriptBox["u", "\[Alpha]"], 
      SuperscriptBox["f", "\[Beta]"], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"d9c19cdb-d25e-46dd-a62e-22ea7d5a9a71"],
 "is the ",
 StyleBox["z",
  FontSlant->"Italic"],
 " component\nDuftdot = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"d", "(", "Duft", ")"}], "/", "d"}], " ", "t"}], 
   TraditionalForm]],ExpressionUUID->"80044476-1487-4767-b3c7-d5e1db015c87"],
 "\nDufxdot = d(Dufx)/d t\nDufydot = d(Dufy)/d t \nDufzdot = d(Dufz)/d t \n\n\
Note that ft, fx, fy, fz also implicitly appear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    SuperscriptBox[
     RowBox[{"\[CapitalPhi]", " "}], "P"]}], TraditionalForm]],ExpressionUUID->
  "dcf95c0f-8801-4d05-b5f6-da3301b25311"],
 " through xpddot and ypddot."
}], "Text",
 CellChangeTimes->{{3.9016446800353236`*^9, 3.9016447469329023`*^9}, {
  3.901644782687561*^9, 3.9016448846168756`*^9}, {3.901644933124316*^9, 
  3.901644935492819*^9}, {3.901644979828142*^9, 3.901645097692999*^9}, {
  3.901645132455763*^9, 3.901645168722143*^9}, {3.901645417262519*^9, 
  3.901645436825117*^9}, {3.9070022852674646`*^9, 3.9070023750875115`*^9}, {
  3.9070024247558546`*^9, 3.9070027980407176`*^9}, {3.907003348371287*^9, 
  3.907003400203761*^9}, {3.907003460882785*^9, 3.90700346116372*^9}, {
  3.948050171790438*^9, 
  3.9480502657790213`*^9}},ExpressionUUID->"7a35dda8-3e80-423e-b6c3-\
5ae51a1d363b"],

