Cell[BoxData[
 RowBox[{
  RowBox[{"dy\[CurlyRho]", "[", 
   RowBox[{
   "\[CapitalDelta]x_", ",", "\[CapitalDelta]y_", ",", "z_", ",", "t_"}], 
   "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"\[CurlyRho]", "[", 
     RowBox[{
     "\[CapitalDelta]x", ",", "\[CapitalDelta]y", ",", "z", ",", "t"}], 
     "]"}]], 
   RowBox[{"(", 
    RowBox[{"\[CapitalDelta]y", "+", 
     FractionBox[
      RowBox[{"2", " ", "M", " ", 
       RowBox[{"yp", "[", "t", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalDelta]x", " ", 
