Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"taudot", "[", "t_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"rp", "[", "t", "]"}], 
      RowBox[{"3", "/", "2"}]]], 
    RowBox[{"(", 
     RowBox[{"\[Sqrt]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "M", " ", 
         SuperscriptBox[
          RowBox[{"rp", "[", "t", "]"}], "2"]}], "-", 
        RowBox[{"4", " ", "M", " ", 
         RowBox[{"rp", "[", "t", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"xp", "[", "t", "]"}], " ", 
            RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"yp", "[", "t", "]"}], " ", 
            RowBox[{"ypdot", "[", "t", "]"}]}]}], ")"}]}], "-", 
        RowBox[{"2", " ", "M", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"xp", "[", "t", "]"}], " ", 
             RowBox[{"xpdot", "[", "t", "]"}]}], "+", 
            RowBox[{
             RowBox[{"yp", "[", "t", "]"}], " ", 
             RowBox[{"ypdot", "[", "t", "]"}]}]}], ")"}], "2"]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"rp", "[", "t", "]"}], "3"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox[
            RowBox[{"xpdot", "[", "t", "]"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"ypdot", "[", "t", "]"}], "2"]}], ")"}]}]}], ")"}]}], 
     ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.896802187605513*^9, 3.896802224661522*^9}, {
