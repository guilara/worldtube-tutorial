  RowBox[{"jump\[Psi]", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"jump\[Psi]r", " ", "=", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"SphericalHarmonicY", "[", 
         RowBox[{"l", ",", "0", ",", 
          RowBox[{"Pi", "/", "2"}], ",", "0"}], "]"}], "]"}], " "}], 
      RowBox[{"\[CapitalEpsilon]", " ", "rp"}]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]in", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"A", " ", "r", " ", 
    RowBox[{"LegendreP", "[", 
     RowBox[{"l", ",", 
      RowBox[{"r", "-", "1"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]out", "[", "r_", "]"}], " ", ":=", " ", 
    RowBox[{"FullSimplify", "[", 
