  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D\[Psi]inp", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Psi]in", "[", "r", "]"}], ",", "r"}], "]"}], " ", "/.", " ", 
    
    RowBox[{"r", "\[Rule]", " ", "rp"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
