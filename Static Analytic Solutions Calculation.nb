      RowBox[{"LegendreQ", "[", 
       RowBox[{"l", ",", "0", ",", "3", ",", 
        RowBox[{"r", "-", "1"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]inp", " ", "=", " ", 
   RowBox[{"\[Psi]in", "[", "rp", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]outp", " ", "=", " ", 
