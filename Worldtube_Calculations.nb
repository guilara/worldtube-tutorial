 CellLabel->"Out[4]=",ExpressionUUID->"5d6d991c-a2fc-44c2-afc0-bc6ed8532dde"]
}, Open  ]],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s do a test of solving for equatorial case and a=0.3 \
and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "KS"], "=", "8"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb5ec678-025c-4aa2-a415-9c424ba89517"],
 ", what the Cartesian radius is."
}], "Text",
 CellChangeTimes->{{3.959918386444901*^9, 3.959918461625393*^9}, {
  3.95991850536127*^9, 
  3.959918510658036*^9}},ExpressionUUID->"01e7de6f-5c57-4cff-80b8-\
b0c0eb19f897"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  SubscriptBox["r", "KS"], "[", 
  RowBox[{"0.3", ",", "r", ",", "0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["r", "KS"], "[", 
      RowBox[{"0.3", ",", "r", ",", "0"}], "]"}], "==", "8"}], "&&", 
    RowBox[{"r", ">", "0"}]}], ",", "r"}], "]"}]}], "Input",
 CellChangeTimes->{{3.959918567497012*^9, 3.959918651203247*^9}, {
   3.959920881185445*^9, 3.959920900123752*^9}, {3.959920936790913*^9, 
   3.959920946937381*^9}, {3.9599215542794*^9, 3.959921558529056*^9}, {
   3.9599288388673353`*^9, 3.959928850125826*^9}, 3.959930512333333*^9, {
   3.959932260025503*^9, 3.9599323597389812`*^9}, {3.959932444498165*^9, 
   3.9599324479845333`*^9}, {3.959932482053895*^9, 3.959932492929789*^9}, {
   3.959933941998541*^9, 3.95993395331824*^9}, {3.9599340390498343`*^9, 
   3.959934121876398*^9}, {3.959934163665575*^9, 3.9599341654862432`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"a84a6c19-3af1-4aee-8990-92168170b799"],

Cell[BoxData[
 FractionBox[
  SqrtBox[
   RowBox[{
    RowBox[{"-", "0.09`"}], "+", 
    SuperscriptBox["r", "2"], "+", 
    SqrtBox[
     RowBox[{"0.`", "\[VeryThinSpace]", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "0.09`"}], "+", 
         SuperscriptBox["r", "2"]}], ")"}], "2"]}]]}]], 
  SqrtBox["2"]]], "Output",
 CellChangeTimes->{{3.959918614237219*^9, 3.9599186525933647`*^9}, {
   3.959920886840657*^9, 3.959920890814321*^9}, {3.959920939262843*^9, 
   3.9599209474283953`*^9}, 3.9599215603710546`*^9, {3.959928856822851*^9, 
   3.959928861550264*^9}, 3.9599289221821947`*^9, {3.959930514376542*^9, 
   3.9599305203425913`*^9}, 3.9599313531978207`*^9, {3.9599323332987947`*^9, 
