   3.959935429446784*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"41b0d9d4-011d-406b-99bc-68d6bd895fc6"],

Cell[BoxData[
 SqrtBox[
  RowBox[{
   RowBox[{"-", 
    SuperscriptBox["a", "2"]}], "+", 
   SuperscriptBox["r", "2"]}]]], "Output",
 CellChangeTimes->{
  3.959933229366417*^9, {3.959933259420678*^9, 3.959933320321995*^9}, {
