Cell[TextData[{
 "We know that for Boyer-Lindquist coordinate: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", "2"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["r", "BL"], "2"], "+", 
        SuperscriptBox["a", "2"]}], ")"}], 
      SuperscriptBox["sin", "2"], "\[Theta]"}], "+", 
     RowBox[{
      SubscriptBox["r", "BL"], 
      SuperscriptBox["cos", "2"], "\[Theta]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0986889b-06b3-4947-8fe8-602b7c9cd11d"],
 ". For equatorial orbits (\[Theta]=\[Pi]/2), we get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "BL"], "=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["r", "2"], "-", 
      SuperscriptBox["a", "2"]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88219723-bd76-463c-8b1e-b56cc664fc53"],
 " ."
}], "Text",
 CellChangeTimes->{{3.959920076758904*^9, 3.9599201377908154`*^9}, {
  3.959929920806703*^9, 3.959929925191103*^9}, {3.959929960489043*^9, 
  3.959930010432301*^9}, {3.959930255698778*^9, 3.9599302594211617`*^9}, {
  3.9599334687605457`*^9, 3.9599334718315163`*^9}, {3.959933558153222*^9, 
  3.9599335619778757`*^9}, {3.959933625662717*^9, 
  3.959933689754106*^9}},ExpressionUUID->"287afd03-964a-446d-b0dc-\
5ce48fd1c85e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BLtoCartrule", "=", 
  RowBox[{
   SubscriptBox["r", "BL"], "->", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["r", "2"], "-", 
     SuperscriptBox["a", "2"]}]]}]}]], "Input",
 CellChangeTimes->{3.95993504316119*^9},
 CellLabel->"In[7]:=",ExpressionUUID->"1e6bef60-0007-4e16-abcf-dedf08721cb8"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["r", "BL"], "\[Rule]", 
  SqrtBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["a", "2"]}], "+", 
    SuperscriptBox["r", "2"]}]]}]], "Output",
 CellChangeTimes->{3.9599350440850267`*^9, 3.9599354298156147`*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"4548d1c4-e19a-4b36-b0d1-5ab075a973fa"]
}, Open  ]],

Cell["\<\
Let\[CloseCurlyQuote]s generate the Cart->KS coord and from there we can \
obtain BL->KS coord transform rule within the confines of equatorial orbits.\
\>", "Text",
 CellChangeTimes->{{3.959934210725378*^9, 3.9599342426757793`*^9}, {
  3.959934363840242*^9, 
  3.959934370987276*^9}},ExpressionUUID->"acfc1833-d60a-4cb9-bad0-\
4baee322c5a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CarttoKSrule", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"rks", "==", 
      RowBox[{
       SubscriptBox["r", "KS"], "[", 
       RowBox[{"a", ",", "r", ",", "0"}], "]"}]}], ",", "r", ",", 
     "PositiveReals"}], "]"}], "//", "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{3.959934310072227*^9, 3.9599344546117268`*^9}, {
  3.959934655680338*^9, 3.9599348108168783`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"2d8d210d-cdc5-4dfc-8fa3-887b278efdc2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"r", "\[Rule]", 
    TemplateBox[{
      SqrtBox[
       RowBox[{
         SuperscriptBox["a", "2"], "+", 
         SuperscriptBox["rks", "2"]}]], 
      RowBox[{
        RowBox[{"rks", ">", "0"}], "&&", 
        RowBox[{"a", ">", "0"}]}]},
     "ConditionalExpression"]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9599343997137613`*^9, 3.959934428357115*^9}, {
   3.959934696232998*^9, 3.9599348113343077`*^9}, 3.959935429868334*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"7366b1d4-f52a-4a2b-b440-d29b43e5be62"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BLtoKSrule", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"rbl", "->", 
         SubscriptBox["r", "BL"]}], "/.", "BLtoCartrule"}], "/.", 
       "CarttoKSrule"}], "}"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "//", "FullSimplify"}], "//", 
   "Normal"}]}]], "Input",
 CellChangeTimes->{{3.959934868680992*^9, 3.959934944941032*^9}, {
  3.9599349880929813`*^9, 3.959934989046864*^9}, {3.959935468848975*^9, 
  3.959935495853915*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"b2033d05-a306-47cd-965e-b7a6b69aa230"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"rbl", "\[Rule]", "rks"}], "}"}]], "Output",
 CellChangeTimes->{{3.959934936949081*^9, 3.95993494528286*^9}, 
   3.959934989791418*^9, 3.959935429881752*^9, {3.959935469925901*^9, 
   3.959935496133296*^9}},
 CellLabel->"Out[18]=",ExpressionUUID->"d547b943-db4f-4de3-b907-4f8167672fd7"]
}, Open  ]],

Cell["\<\
We can now convert our azimuthal orbital velocity from BL->KS coordinates\
\>", "Text",
 CellChangeTimes->{{3.9599348352666273`*^9, 
  3.95993485834482*^9}},ExpressionUUID->"b9eda50a-7df8-4fcb-90aa-\
eaca77639b99"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]dot", "[", 
    RowBox[{"a_", ",", "r_"}], "]"}], ":=", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox["r", 
      FractionBox["3", "2"]], "+", "a"}]]}], " ", 
  RowBox[{"(*", 
   RowBox[{"This", " ", "is", " ", 
    RowBox[{"d\[Phi]", "/", "dt"}], " ", "in", " ", "BL", " ", 
    RowBox[{"coords", ".", " ", "Comes"}], " ", "from", " ", "eqn", " ", 
    RowBox[{"(", "2.16", ")"}], " ", "of", " ", "Bardeen", " ", 
    RowBox[{"(", "1972", ")"}], " ", 
    RowBox[{"et", ".", "al", ".", " ", "Agrees"}], " ", "to", " ", 
    "BHPertToolkit"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[Phi]d", "=", 
  RowBox[{
   RowBox[{"\[Phi]dot", "[", 
