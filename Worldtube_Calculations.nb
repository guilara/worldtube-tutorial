        RowBox[{"i", "==", "j", "==", "3"}], ",", "\[CapitalSigma]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"i", "==", "j", "==", "4"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           SuperscriptBox["a", "2"], "+", 
           RowBox[{"B", " ", 
            SuperscriptBox["a", "2"], 
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}], 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"i", "==", "1"}], " ", "&&", " ", 
           RowBox[{"j", "==", "2"}]}], ")"}], "||", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"i", "==", "2"}], "&&", 
           RowBox[{"j", "==", "1"}]}], ")"}]}], ",", "B", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"i", "==", "1"}], "&&", 
           RowBox[{"j", "==", "4"}]}], ")"}], "||", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"i", "==", "4"}], "&&", 
           RowBox[{"j", "==", "1"}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "B", " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"i", "==", "2"}], "&&", 
           RowBox[{"j", "==", "4"}]}], ")"}], "||", 
         RowBox[{"(", 
