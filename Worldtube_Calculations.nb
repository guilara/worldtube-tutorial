Cell[BoxData[{
 RowBox[{
  RowBox[{"(", 
   RowBox[{"angvelKS", "=", 
    RowBox[{"JacBLtoKS", ".", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "tdot", "}"}], ",", 
       RowBox[{"{", "rdot", "}"}], ",", 
       RowBox[{"{", "\[Theta]dot", "}"}], ",", 
       RowBox[{"{", "\[Phi]dot", "}"}]}], "}"}]}]}], ")"}], "//", 
