Cell["\<\
Plotting out the two functions. Expectations: They must intersect at 8M (our \
\[OpenCurlyDoubleQuote]initial condition\[CloseCurlyDoubleQuote]).\
\>", "Text",
 CellChangeTimes->{{3.955523197827194*^9, 
  3.955523240200519*^9}},ExpressionUUID->"64f44958-1cea-4db4-89a0-\
