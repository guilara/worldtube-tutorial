Cell[TextData[{
 "We can obtain the circular orbit condition from first principles. We know \
due to the normalisation condition that  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "\[Congruent]", 
     RowBox[{
      SubscriptBox["g", "\[Mu]\[Nu]"], 
      SuperscriptBox[
       OverscriptBox["x", "."], "\[Mu]"], 
      SuperscriptBox[
       OverscriptBox["x", "."], "\[Nu]"]}]}], "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "861e2746-e5c2-a146-8868-2e6851d27eac"],
 ". Thus, we can set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "\[ScriptCapitalL]"}], 
     RowBox[{"\[PartialD]", "r"}]], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "96a9927e-6cca-5d4e-946f-fb69a785c294"],
 ". We also ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"define", " ", 
     SuperscriptBox[
      OverscriptBox["x", "."], "\[Mu]"]}], "\[Congruent]", 
    RowBox[{
     FractionBox["1", "d\[Tau]"], 
     RowBox[{"(", 
      RowBox[{"dt", ",", "dr", ",", "d\[Theta]", ",", "d\[Phi]"}], ")"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "354f9b83-a363-804d-adf5-8b811826f778"],
 ". With equatorial condition, we have the following restrictions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["r", "."], "=", 
    RowBox[{
     OverscriptBox["\[Theta]", "."], "=", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4b2e043-c3b6-414e-99e0-2170e7216d8a"],
 ". This results in the following equation: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["g", "tt"]}], 
       RowBox[{"\[PartialD]", "r"}]], 
      SuperscriptBox[
       OverscriptBox["t", "."], "2"]}], "+", 
     RowBox[{"2", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["g", "t\[Phi]"]}], 
       RowBox[{"\[PartialD]", "r"}]], 
      OverscriptBox["t", "."], 
      OverscriptBox["\[Phi]", "."]}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["g", "\[Phi]\[Phi]"]}], 
       RowBox[{"\[PartialD]", "r"}]], 
      SuperscriptBox[
       OverscriptBox["\[Phi]", "."], "2"]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "013d5989-0b2a-c646-b75f-d7b8d37e1502"],
 ". Finally, dividing by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["t", "."], "2"], TraditionalForm]],ExpressionUUID->
  "bd58029e-6ace-e541-8eee-c931f2ea9899"],
 " gives us the following quadratic equations we can solve: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["g", "tt"]}], 
      RowBox[{"\[PartialD]", "r"}]], "+", 
     RowBox[{"2", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["g", "t\[Phi]"]}], 
       RowBox[{"\[PartialD]", "r"}]], 
      FractionBox["d\[Phi]", "dt"]}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["g", "\[Phi]\[Phi]"]}], 
       RowBox[{"\[PartialD]", "r"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["d\[Phi]", "dt"], ")"}], "2"]}]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"c6ed2ac5-42e0-da46-a4f2-4a933c00bb51"],
 ". "
}], "Text",
 CellChangeTimes->{{3.960217429233181*^9, 3.9602174430236893`*^9}, {
  3.960217479662325*^9, 3.9602177958063965`*^9}, {3.9602178996757774`*^9, 
  3.9602179797487755`*^9}, {3.960219182285082*^9, 3.9602195106012726`*^9}, {
  3.960219541293535*^9, 3.9602197755601196`*^9}, {3.9602199387574596`*^9, 
  3.960219994489916*^9}},ExpressionUUID->"019694d4-6672-bf45-8a1b-\
8dd8f01efa1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quadratic", "=", 
  RowBox[{
   RowBox[{
