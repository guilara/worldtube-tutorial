Cell[CellGroupData[{

Cell["KS \[Phi] Calculations", "Section",
 CellChangeTimes->{{3.9599351342672167`*^9, 
  3.959935147576593*^9}},ExpressionUUID->"c274cfaa-18c4-401b-a7a5-\
e4ba1f71b10f"],

Cell[TextData[{
 "We wish to calculate circular angular velocity for Kerr in KS coordinate. \
We denote any quantity in KS coordinate with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "KS"], TraditionalForm]],ExpressionUUID->
  "604028fa-b0a5-496e-846f-87f95ad83865"],
 " subscript. The only thing that between KS and Cart is the radial \
component; The azimuthal piece should be the same since it drops out always \
between y and z. In the equatorial we also expect \[Theta] to not factor in \
anymore."
}], "Text",
 CellChangeTimes->{{3.9599157496390533`*^9, 3.959915762301907*^9}, {
  3.95991597604793*^9, 3.959915979366427*^9}, {3.959917810244035*^9, 
  3.959917837569387*^9}, {3.959931096569688*^9, 3.9599311448945*^9}, {
  3.959931186036919*^9, 3.959931233537959*^9}, {3.9599318324811172`*^9, 
  3.9599318533469357`*^9}},ExpressionUUID->"4dc64fab-53d9-4a56-98cd-\
f034aafeef88"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   SubscriptBox["r", "KS"], "[", 
   RowBox[{"a_", ",", "r_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"\[Sqrt]", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["r", "2"], "-", 
       SuperscriptBox["a", "2"], "+", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["r", "2"], "-", 
            SuperscriptBox["a", "2"]}], ")"}], "2"], "+", 
         RowBox[{"4", 
          SuperscriptBox["a", "2"], 
          SuperscriptBox["z", "2"]}]}]]}], ")"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["r", "KS"], "[", 
     RowBox[{"a", ",", "r", ",", 
      RowBox[{"r", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "]"}], "/.", 
    RowBox[{"\[Theta]", "->", 
     RowBox[{"Pi", "/", "2"}]}]}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", ">", "a"}], ",", 
      RowBox[{
       RowBox[{"r", "+", "a"}], ">", "0"}]}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "===", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["r", "KS"], "[", 
     RowBox[{"a", ",", "r", ",", "0"}], "]"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", ">", "a"}], ",", 
       RowBox[{
        RowBox[{"r", "+", "a"}], ">", "0"}]}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    SubscriptBox["r", "KS"], "[", 
    RowBox[{"a", ",", "r", ",", "0"}], "]"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", ">", "a"}], ",", 
      RowBox[{
       RowBox[{"r", "+", "a"}], ">", "0"}]}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQAGIQ3Sa8dsWHhreOO2vKV4NotewXO0G0jPqEfSD6TVrL
