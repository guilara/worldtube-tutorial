Cell[TextData[{
 "Transforming a contravariant-vector in GR goes as: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"V", "'"}], "\[Alpha]"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        RowBox[{"x", "'"}], "\[Alpha]"]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "\[Beta]"]}]], 
     SuperscriptBox["V", "\[Beta]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e1b773c2-febd-db41-99fd-c97f6782e5c8"],
 ". The 4-velocity is (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["t", "."], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd23f9ff-e769-0942-82bf-f026eafec708"],
 ",  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["r", "."], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef5f808d-9a51-7a4c-a2f4-88e3094d991a"],
 ", ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Theta]", "."], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e49abd2-6d87-d644-a682-1b1c70ea745c"],
 ", ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Phi]", "."], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67921727-0a0e-f54b-8d8c-d7ff9c670b1c"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[")", "T"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f30aa7ab-9923-a844-ba5e-787010333265"],
 "."
}], "Text",
 CellChangeTimes->{{3.9599577716009083`*^9, 3.959957953571821*^9}, {
  3.9599579962586136`*^9, 3.959958011461708*^9}, {3.959958051847994*^9, 
  3.9599582465126*^9}, {3.959959921616276*^9, 3.959959941519253*^9}, {
  3.959959976007822*^9, 
  3.959960005791935*^9}},ExpressionUUID->"aa5f7df1-cb78-944e-9722-\
cf98472372d1"],

