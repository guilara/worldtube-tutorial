Cell["\<\
Now we consider the coordinate transformation for BL coordinate which is the \
oblate spheroidal transformation\
\>", "Text",
 CellChangeTimes->{{3.9599526539924316`*^9, 
  3.9599526801188583`*^9}},ExpressionUUID->"07736aad-8fa7-7e40-9998-\
ccae4aa8178e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"x2", "=", 
  RowBox[{
   SqrtBox[
    RowBox[{
     SuperscriptBox["rbl", "2"], "+", 
     SuperscriptBox["a", "2"]}]], 
   RowBox[{"Sin", "[", "\[Theta]", "]"}], 
   RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"y2", "=", 
  RowBox[{
   SqrtBox[
    RowBox[{
     SuperscriptBox["rbl", "2"], "+", 
     SuperscriptBox["a", "2"]}]], 
   RowBox[{"Sin", "[", "\[Theta]", "]"}], 
   RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"z2", "=", 
  RowBox[{"rbl", " ", 
   RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"JacBLtoCart", "=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", "x2", ",", "y2", ",", "z2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"t", ",", "rbl", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], 
        "}"}]}], "]"}], "//", "FullSimplify"}]}], ")"}], "//", 
  "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.9599526854003067`*^9, 3.959952705068577*^9}, {
  3.9599527672409096`*^9, 3.959952785006544*^9}, {3.9599530129513283`*^9, 
  3.9599531019741764`*^9}, {3.95995324227326*^9, 3.95995325434223*^9}, {
