        RowBox[{
         RowBox[{"-", "a"}], 
         RowBox[{"(", 
          RowBox[{"1", "+", "B"}], ")"}], 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ",", 
        "\[IndentingNewLine]", "True", ",", "0"}], "\[IndentingNewLine]", 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "4"}], "}"}]}], "]"}]}], ")"}], "//", 
  "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "/.", 
   RowBox[{"\[Theta]", "->", 
    FractionBox["Pi", "2"]}]}], "//", 
  "MatrixForm"}], "\[IndentingNewLine]"}], "Input",
