Notebook[{
Cell[TextData[{
 "Investigating the excision radius function for the case of the BH.\nThe \
following parameters were considered: \[Beta]=1, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "0"], "=", "8"}], TraditionalForm]],ExpressionUUID->
  "38eb219d-bb2f-454b-a450-550b5dfb42a4"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", 
    RowBox[{
     SubscriptBox["R", "0"], "=", "1.5"}]}], TraditionalForm]],ExpressionUUID->
  "185afb0a-0441-408f-94c3-e19c515e9a38"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "\[Infinity]"], "="}], TraditionalForm]],ExpressionUUID->
  "edd27b40-88dd-4341-b940-63fb88224a24"],
 "1.9, \[CapitalDelta]=0.05"
}], "Text",
 CellChangeTimes->{{3.9555213542045794`*^9, 3.9555215297362633`*^9}, {
  3.955521658279482*^9, 3.955521658938739*^9}, {3.955522326259945*^9, 
  3.955522348309801*^9}, {3.956110476872613*^9, 3.956110479261473*^9}, {
  3.956645937600251*^9, 
  3.956645942453532*^9}},ExpressionUUID->"ef2c0bbe-f812-4c33-9c86-\
3742a1a3be1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Beta]", "=", "1"}], ";", 
  RowBox[{"r0", "=", "8"}], ";", 
  RowBox[{"R0", "=", "1.5"}], ";", 
  RowBox[{"Ri", "=", "1.9"}], ";", 
  RowBox[{"\[CapitalDelta]", "=", "0.05"}], ";"}]], "Input",
 CellChangeTimes->{{3.955522484265899*^9, 3.955522600200939*^9}, {
  3.955522794148368*^9, 3.955522807902865*^9}, {3.955525075900788*^9, 
  3.955525078638032*^9}, {3.9566316134843388`*^9, 3.95663166563912*^9}, {
  3.956631775517563*^9, 3.956631843779051*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"c6718e38-a4e4-4c56-9fb3-8d341eb29c36"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Recc", "[", 
   RowBox[{"r_", ",", "c_"}], "]"}], ":=", 
  RowBox[{"Ri", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"r", "/", "c"}], ")"}], "\[Beta]"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r", "/", "c"}], ")"}], 
       RowBox[{"1", "/", "\[CapitalDelta]"}]]}], ")"}], 
    RowBox[{
     RowBox[{"-", "\[Beta]"}], " ", 
     "\[CapitalDelta]"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rcirc", "[", "r_", "]"}], ":=", 
  RowBox[{"R0", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"r", "/", "r0"}], ")"}], "\[Beta]"]}]}]}], "Input",
 CellChangeTimes->{{3.955522383620408*^9, 3.95552251519445*^9}, {
  3.9555226111871147`*^9, 3.955522746003153*^9}, {3.955522802438512*^9, 
  3.955522833437841*^9}, {3.955523546119985*^9, 3.955523546457473*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"18d28945-9f15-4775-aa8e-64814c0780c8"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s root find a c for Recc that would set Recc=!=Rcirc \
when r=8M. In otherwords ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "0"], TraditionalForm]],ExpressionUUID->
  "c46aa811-a0d3-446a-92e2-f709eaca39d0"],
 "=",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["R", "\[Infinity]"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"r", "/", "c"}], ")"}], "\[Beta]"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r", "/", "c"}], ")"}], 
       RowBox[{"1", "/", "\[CapitalDelta]"}]]}], ")"}], 
    RowBox[{
     RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]"}]]}]], "Input",
  CellChangeTimes->{{3.955522383620408*^9, 3.95552251519445*^9}, {
   3.9555226111871147`*^9, 3.955522746003153*^9}, {3.955522802438512*^9, 
   3.955522833437841*^9}},ExpressionUUID->
  "91b2d4bb-720d-4463-9b4c-4d9fc584134e"],
 "."
}], "Text",
 CellChangeTimes->{{3.95552283624867*^9, 3.955522919644285*^9}, {
  3.9555236143160543`*^9, 
  3.955523618700955*^9}},ExpressionUUID->"85e5f96d-92e8-4071-86b8-\
439596891be8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"crule", "=", 
  RowBox[{
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Recc", "[", 
       RowBox[{"6", ",", "c"}], "]"}], "==", "R0"}], ",", "c", ",", "Reals"}],
     "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Recc", "[", 
   RowBox[{"9", ",", "c"}], "]"}], "/.", "crule"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Recc2", "[", "r_", "]"}], ":=", 
  RowBox[{
