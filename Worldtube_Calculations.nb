Cell[BoxData[{
 RowBox[{
  RowBox[{"(", 
   RowBox[{"g", "=", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"i", "==", "j", "==", "1"}], ",", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "-", "B"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"i", "==", "j", "==", "2"}], ",", 
