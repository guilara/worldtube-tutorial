Cell[TextData[{
 "From this we recognise for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"formula", ":", " ", 
    FractionBox["d\[Phi]", "dt"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f82a323e-127d-8f4c-a05d-93c6d11ec5ee"],
 "=",
 Cell[BoxData[
  FormBox[
   FractionBox["d\[CurlyPhi]", "dt"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "61f563f7-0658-cc46-9f65-d1e36bebb1d4"],
 " in the circular limit. Directly reading off the coordinates between BL and \
KS obtains us the same Jacobian"
}], "Text",
 CellChangeTimes->{{3.9599552286630974`*^9, 3.959955300831827*^9}, {
  3.9599574684059944`*^9, 3.9599575046397953`*^9}, {3.959959686151264*^9, 
