Cell["\<\
Plotting out the two functions. Expectations: They must intersect at 8M (our \
\[OpenCurlyDoubleQuote]initial condition\[CloseCurlyDoubleQuote]).\
\>", "Text",
 CellChangeTimes->{{3.955523197827194*^9, 
  3.955523240200519*^9}},ExpressionUUID->"64f44958-1cea-4db4-89a0-\
a84168caa41b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Rcirc", "[", "r", "]"}], ",", 
     RowBox[{"Recc2", "[", "r", "]"}], ",", 
     RowBox[{"Recc", "[", 
      RowBox[{"r", ",", "8"}], "]"}], ",", "1.99"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<r\>\"", ",", "\"\<R(r)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\!\(\*SubscriptBox[\(R\), \(old\)]\)(r)\>\"", ",", 
      "\"\<\!\(\*SubscriptBox[\(R\), \(new\)]\)(r)\>\"", ",", "1.99"}], 
     "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<BH Excision Radius\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.955522757437362*^9, 3.9555227729075136`*^9}, {
