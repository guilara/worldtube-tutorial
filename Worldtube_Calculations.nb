Cell[BoxData[{
 RowBox[{
  RowBox[{"Z1", "[", "a_", "]"}], ":=", 
  RowBox[{"1", "+", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["a", "2"]}], ")"}], 
     RowBox[{"1", "/", "3"}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], ")"}], 
       RowBox[{"1", "/", "3"}]], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "a"}], ")"}], 
       RowBox[{"1", "/", "3"}]]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z2", "[", "a_", "]"}], ":=", 
  SqrtBox[
   RowBox[{
    RowBox[{"3", 
     SuperscriptBox["a", "2"]}], "+", 
    SuperscriptBox[
     RowBox[{"Z1", "[", "a", "]"}], "2"]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rpro", "[", "a_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{"3", "+", 
    RowBox[{"Z2", "[", "a", "]"}], "-", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "-", 
        RowBox[{"Z1", "[", "a", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"Z1", "[", "a", "]"}], "+", 
        RowBox[{"2", 
         RowBox[{"Z2", "[", "a", "]"}]}]}], ")"}]}]]}], 
   ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rret", "[", "a_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{"3", "+", 
    RowBox[{"Z2", "[", "a", "]"}], "+", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "-", 
        RowBox[{"Z1", "[", "a", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"Z1", "[", "a", "]"}], "+", 
        RowBox[{"2", 
         RowBox[{"Z2", "[", "a", "]"}]}]}], ")"}]}]]}], ")"}]}]}], "Input",
 CellChangeTimes->{{3.9600027888660946`*^9, 3.960002952509197*^9}, {
