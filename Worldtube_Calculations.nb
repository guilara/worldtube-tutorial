 CellLabel->"Out[5]=",ExpressionUUID->"873bc578-6a6e-41fb-8735-88846eddc50c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"r", "\[Rule]", "8.005623023850175`"}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.959918614237219*^9, 3.9599186525933647`*^9}, {
   3.959920886840657*^9, 3.959920890814321*^9}, {3.959920939262843*^9, 
   3.9599209474283953`*^9}, 3.9599215603710546`*^9, {3.959928856822851*^9, 
