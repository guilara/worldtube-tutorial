Cell[TextData[{
 "Now let\[CloseCurlyQuote]s compute the angular velocity and the velocity of \
circular orbits. From Bardeen (1972) et. al., the angular velocity for a \
circular orbit is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d\[Phi]", "dt"], "=", 
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["r", 
       RowBox[{"3", "/", "2"}]], "+", "a"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ba698865-c04f-2f49-a928-39a5baf5d0e6"],
 "."
}], "Text",
 CellChangeTimes->{{3.959959395847725*^9, 3.959959404473427*^9}, {
  3.9599594409289303`*^9, 
  3.959959553497532*^9}},ExpressionUUID->"48d6adb5-ef1a-8247-8582-\
70872f51f0e2"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9599596265022697`*^9, 
  3.9599596280208893`*^9}},ExpressionUUID->"85b4f1f4-a96b-0544-bf94-\
c4a17d1a516c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rsq", "[", 
   RowBox[{"a_", ",", "x_"}], "]"}], ":=", 
  SqrtBox[
   RowBox[{
    SuperscriptBox["x", "2"], "-", 
    SuperscriptBox["a", "2"]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phidot", "[", 
   RowBox[{"a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"-", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"rsq", "[", 
       RowBox[{"a", ",", "x"}], "]"}], 
      RowBox[{"3", "/", "2"}]], "-", "a"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "[", 
   RowBox[{"a_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"x", " ", 
   RowBox[{"phidot", "[", 
    RowBox[{"a", ",", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phidot", "[", 
   RowBox[{"0.3", ",", "8"}], "]"}], "//", "N"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "[", 
